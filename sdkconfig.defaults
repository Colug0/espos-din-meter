# espos-din-meter: only what differs from espOS. espos_project_prologue() puts
# espos/sdkconfig.d/espos.defaults first; later files win. Delete
# build/sdkconfig after changing anything here: defaults reach a fresh
# sdkconfig only.

# ---- Target: one board, one chip.
CONFIG_IDF_TARGET="esp32s3"

# ---- CPU
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ---- LVGL (Kconfig-configured, through esp_lvgl_port). No animations, the three
# font sizes the renderer uses, and a 16 KB object pool: the 64 KB default
# left about 18 KB of heap on this PSRAM-less board and WiFi, HTTP and the
# Signal K stream began to fail. The UI is a handful of labels.
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_THEME_DEFAULT_TRANSITION_TIME=0
CONFIG_LV_MEM_SIZE=16384
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n

# ---- Trace facility for stack high-water marks (espos-memory-budget)
CONFIG_FREERTOS_USE_TRACE_FACILITY=y

# ---- Internal RAM: WiFi driver code in flash, not IRAM. On the S3 code and
# data share internal SRAM, so IRAM taken by WiFi speed-ups is heap the
# TLS handshakes to Signal K need (24 KB in one block each). The cost is
# throughput a display that moves a few KB/s never uses.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n

# ---- WiFi buffers, as on espos-m5-tough: 6 static RX buffers instead of 10
# (6 = CONFIG_ESP_WIFI_RX_BA_WIN, so aggregation still fits; frees 6.4 KB),
# at most 16 queued frames instead of 32 and two segments in flight per TCP
# connection instead of four. TCP resends what is dropped; the display moves
# a few KB/s.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_LWIP_TCP_WND_DEFAULT=2880

# ---- Main task: espos_start() runs on it and left 320-448 bytes of the
# 3584 default unused (measured with the stack reserve log line).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=5120
